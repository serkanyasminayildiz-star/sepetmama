# Database (Supabase Postgres)
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGc..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGc..."

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google ile giriş (OAuth) — Google Cloud Console > APIs & Services > Credentials
# > OAuth 2.0 Client ID (Web application). Boş bırakırsan Google butonu çalışmaz,
# e-posta/şifre girişi çalışmaya devam eder.
# Authorized redirect URI: https://www.sepetmama.com/api/auth/callback/google
# (local için: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# PayTR
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# 1 = test mode (sahte karlarla test), 0 = production (gerçek ödeme)
# Production'da MUTLAKA 0 olmalı!
PAYTR_TEST_MODE="1"

# Google Search Console — site verification kodu. Property eklerken HTML tag
# yöntemini seçersen, "content" değerini buraya yaz (sadece kod, tag değil).
# Örn: "abc123XYZ-token". DNS verify kullanırsan bu env'e gerek yok.
GOOGLE_SITE_VERIFICATION=""

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX). Boş bırakırsan analytics yüklenmez.
NEXT_PUBLIC_GA4_ID=""
# Google Ads — Conversion ID (AW-XXXXXXXXXX). Boş bırakırsan Ads tracking yok.
NEXT_PUBLIC_GOOGLE_ADS_ID=""
# Google Ads — Purchase conversion label. Format: "AW-XXXXXXXXXX/AbCdEfGhIj"
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=""

# Resend (transactional email) — https://resend.com
# API key: Dashboard → API Keys → Create. Boş bırakırsan email atılmaz, callback silent skip yapar (sipariş yine CONFIRMED olur).
RESEND_API_KEY=""
# Gönderici. Resend'de doğrulanmış domain ile eşleşmeli (apex veya subdomain).
EMAIL_FROM="SepetMama <siparis@sepetmama.com>"
# Admin bildirim emaili (yeni sipariş gelirse buraya da bildirim atılır).
ADMIN_EMAIL="info@sepetmama.com"
